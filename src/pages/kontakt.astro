---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Kontakt"
  description="Kancelaria Notarialna w Wągrowcu – adres, telefon, godziny urzędowania, rachunki bankowe. ul. Kościuszki 18B, 62-100 Wągrowiec. Tel. 67 26 20 868."
>

  <!-- Page header -->
  <div class="bg-[#231F1C] py-14 md:py-20">
    <div class="container-wide">
      <p class="font-sans text-[#A38A66] text-xs tracking-[0.3em] uppercase mb-3">
        Kancelaria Notarialna w Wągrowcu
      </p>
      <h1 class="font-serif text-4xl md:text-5xl text-white font-semibold">
        Kontakt
      </h1>
    </div>
  </div>

  <!-- Breadcrumb -->
  <div class="bg-[#EFEBE3] border-b border-stone-300">
    <div class="container-wide py-3">
      <nav class="font-sans text-xs text-[#6B6864]">
        <a href="/" class="hover:text-[#A38A66] transition-colors">Strona główna</a>
        <span class="mx-2">›</span>
        <span class="text-[#2C2A28]">Kontakt</span>
      </nav>
    </div>
  </div>

  <section class="py-16 md:py-24 bg-[#FDFBF7]">
    <div class="container-wide">

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">

        <!-- Left column: dane kontaktowe -->
        <div class="lg:col-span-2 space-y-10">

          <!-- Adres -->
          <div>
            <h2 class="font-serif text-2xl text-[#2C2A28] font-semibold mb-1">
              Kancelaria Notarialna
            </h2>
            <p class="font-sans text-[#A38A66] text-xs tracking-widest uppercase mb-5">Wągrowiec</p>

            <address class="not-italic space-y-4">
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#A38A66] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <div class="font-sans text-[#4A4744] text-sm">
                  <p class="font-medium text-[#2C2A28]">ul. Kościuszki 18B</p>
                  <p>62-100 Wągrowiec</p>
                  <p class="text-[#6B6864] text-xs mt-1">Dostępny parking przy kancelarii</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#A38A66] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <div class="font-sans text-[#4A4744] text-sm space-y-1">
                  <a href="tel:+48672620868" class="block font-medium text-[#2C2A28] hover:text-[#A38A66] transition-colors text-base">
                    67 26 20 868
                  </a>
                  <a href="tel:+48672685665" class="block hover:text-[#A38A66] transition-colors">
                    67 26 85 665
                  </a>
                  <a href="tel:+48693363868" class="block hover:text-[#A38A66] transition-colors">
                    693 363 868
                    <span class="text-[#6B6864] text-xs ml-1">(komórkowy)</span>
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#A38A66] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <div class="font-sans text-[#4A4744] text-sm space-y-1.5">
                  <div>
                    <p class="text-[#6B6864] text-xs">notariusz Katarzyna Sokołowska</p>
                    <a href="mailto:sokolows@rejent.poznan.pl" class="block text-[#A38A66] hover:underline text-xs break-all">
                      sokolows@rejent.poznan.pl
                    </a>
                  </div>
                  <div>
                    <p class="text-[#6B6864] text-xs">notariusz Maria Majchrzak</p>
                    <a href="mailto:m.majchrzak@rejent.poznan.pl" class="block text-[#A38A66] hover:underline text-xs break-all">
                      m.majchrzak@rejent.poznan.pl
                    </a>
                  </div>
                </div>
              </div>
            </address>
          </div>

          <!-- Godziny urzędowania -->
          <div>
            <h3 class="font-serif text-xl text-[#2C2A28] font-semibold mb-4">
              Godziny urzędowania
            </h3>
            <table class="w-full font-sans text-sm">
              <tbody>
                {[
                  { dzien: 'Poniedziałek', godziny: '8:00 – 16:00' },
                  { dzien: 'Wtorek', godziny: '8:00 – 16:00' },
                  { dzien: 'Środa', godziny: '8:00 – 16:00' },
                  { dzien: 'Czwartek', godziny: '8:00 – 16:00' },
                  { dzien: 'Piątek', godziny: '8:00 – 16:00' },
                  { dzien: 'Sobota', godziny: 'nieczynne', nieczynne: true },
                  { dzien: 'Niedziela', godziny: 'nieczynne', nieczynne: true },
                ].map(row => (
                  <tr class="border-b border-stone-200">
                    <td class={`py-2.5 pr-4 ${row.nieczynne ? 'text-[#6B6864]' : 'text-[#2C2A28] font-medium'}`}>
                      {row.dzien}
                    </td>
                    <td class={`py-2.5 text-right ${row.nieczynne ? 'text-[#6B6864]' : 'text-[#A38A66] font-medium'}`}>
                      {row.godziny}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="font-sans text-xs text-[#6B6864] mt-3">
              Czynności mogą być dokonywane również poza siedzibą kancelarii i poza godzinami urzędowania — po wcześniejszym uzgodnieniu.
            </p>
          </div>

          <!-- Dane rejestrowe -->
          <div class="bg-[#EFEBE3] p-6">
            <h3 class="font-sans text-xs text-[#6B6864] uppercase tracking-widest font-medium mb-4">
              Dane rejestrowe
            </h3>
            <dl class="space-y-2 font-sans text-sm">
              <div class="flex justify-between gap-4">
                <dt class="text-[#6B6864]">Pełna nazwa</dt>
                <dd class="text-[#2C2A28] font-medium text-right text-xs">
                  Kancelaria Notarialna K. Sokołowska M. Majchrzak s.c.
                </dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-[#6B6864]">NIP</dt>
                <dd class="text-[#2C2A28] font-medium">766-199-76-89</dd>
              </div>
            </dl>
          </div>

        </div>

        <!-- Right column: mapa + rachunki -->
        <div class="lg:col-span-3 space-y-10">

          <!-- Mapa Google -->
          <div>
            <h3 class="font-serif text-xl text-[#2C2A28] font-semibold mb-4">
              Lokalizacja
            </h3>
            <!-- Google Maps iframe placeholder - właściciel strony podmieni src na właściwy link -->
            <div class="w-full h-80 md:h-96 bg-stone-200 border border-stone-300 overflow-hidden">
              <!-- INSTRUKCJA: Podmień src poniżej na własny link do Google Maps.
                   Wejdź na maps.google.com → wyszukaj kancelarię → Udostępnij → Umieść mapę → skopiuj URL iframe -->
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2433.0!2d17.2!3d52.8!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNTLCsDQ4JzAwLjAiTiAxN8KwMTInMDAuMCJF!5e0!3m2!1spl!2spl!4v1234567890"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Lokalizacja Kancelarii Notarialnej w Wągrowcu"
              ></iframe>
            </div>
            <p class="font-sans text-xs text-[#6B6864] mt-2">
              ul. Kościuszki 18B, 62-100 Wągrowiec
            </p>
          </div>

          <!-- Rachunki bankowe -->
          <div>
            <h3 class="font-serif text-xl text-[#2C2A28] font-semibold mb-4">
              Rachunki bankowe
            </h3>

            <div class="space-y-4">

              <!-- Rachunek kancelarii -->
              <div class="border border-stone-200 p-5 bg-white">
                <div class="flex items-start justify-between gap-4 mb-3">
                  <div>
                    <p class="font-sans text-xs text-[#6B6864] uppercase tracking-widest font-medium mb-1">
                      Rachunek kancelarii
                    </p>
                    <p class="font-sans text-[#4A4744] text-xs">
                      Przeznaczony na opłaty za czynności notarialne, taksę, podatki i opłaty sądowe
                    </p>
                  </div>
                  <div class="w-8 h-8 rounded-full bg-[#EFEBE3] flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#A38A66]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                    </svg>
                  </div>
                </div>
                <div class="bg-[#EFEBE3] px-4 py-3">
                  <p class="font-sans text-[#2C2A28] font-medium text-sm tracking-wider break-all">
                    PL96 1240 3725 1111 0010 7876 2038
                  </p>
                  <p class="font-sans text-[#6B6864] text-xs mt-1">Bank PKO BP</p>
                </div>
              </div>

              <!-- Rachunek depozytowy -->
              <div class="border border-stone-200 p-5 bg-white">
                <div class="flex items-start justify-between gap-4 mb-3">
                  <div>
                    <p class="font-sans text-xs text-[#6B6864] uppercase tracking-widest font-medium mb-1">
                      Rachunek depozytowy
                    </p>
                    <p class="font-sans text-[#4A4744] text-xs">
                      Przeznaczony wyłącznie do przyjmowania depozytów notarialnych (art. 108 § 1 Prawa o notariacie)
                    </p>
                  </div>
                  <div class="w-8 h-8 rounded-full bg-[#EFEBE3] flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#A38A66]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                  </div>
                </div>
                <div class="bg-[#EFEBE3] px-4 py-3">
                  <p class="font-sans text-[#6B6864] text-sm italic">
                    Numer rachunku depozytowego zostanie podany przez kancelarię indywidualnie
                    w treści aktu notarialnego lub umowy depozytowej.
                  </p>
                </div>
                <p class="font-sans text-xs text-[#6B6864] mt-3">
                  <strong class="font-medium text-[#2C2A28]">Uwaga:</strong> Środki pieniężne na rachunek depozytowy
                  należy przelewać wyłącznie po otrzymaniu pisemnej dyspozycji od kancelarii, z podaniem
                  prawidłowego tytułu przelewu.
                </p>
              </div>

            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

</Layout>
