---
export interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'Kancelaria Notarialna Katarzyna Sokołowska i Maria Majchrzak – notariusze w Wągrowcu. Akty notarialne, poświadczenia, prawo spadkowe, nieruchomości.',
  canonical,
} = Astro.props;

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Strona główna' },
  { href: '/kancelaria', label: 'O kancelarii' },
  { href: '/czynnosci-notarialne', label: 'Czynności notarialne' },
  { href: '/oplaty', label: 'Opłaty' },
  { href: '/kontakt', label: 'Kontakt' },
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title} | Kancelaria Notarialna Wągrowiec</title>
  </head>

  <body class="bg-[#FDFBF7] text-[#2C2A28] font-sans">

    <!-- Top bar -->
    <div class="bg-[#231F1C] text-stone-300 text-sm hidden md:block">
      <div class="container-wide flex items-center justify-between py-2">
        <span class="text-stone-400 font-light">ul. Kościuszki 18B, 62-100 Wągrowiec</span>
        <div class="flex items-center gap-6">
          <a href="tel:+48672620868" class="hover:text-[#C4A87E] transition-colors flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            67 26 20 868
          </a>
          <a href="tel:+48693363868" class="hover:text-[#C4A87E] transition-colors flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
            693 363 868
          </a>
          <span class="text-stone-500">|</span>
          <span class="text-stone-400">Pon–Pt: 8:00–16:00</span>
        </div>
      </div>
    </div>

    <!-- Main navigation -->
    <header id="main-header" class="bg-[#FDFBF7] border-b border-stone-200 sticky top-0 z-50 shadow-sm">
      <div class="container-wide flex items-center justify-between py-4">

        <!-- Logo / Firma -->
        <a href="/" class="flex flex-col leading-none">
          <span class="font-serif text-lg md:text-xl text-[#2C2A28] font-semibold tracking-wide">
            Kancelaria Notarialna
          </span>
          <span class="font-sans text-xs text-[#A38A66] tracking-[0.2em] uppercase mt-0.5">
            Wągrowiec
          </span>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden lg:flex items-center gap-1">
          {navLinks.map(link => (
            <a
              href={link.href}
              class={`px-4 py-2 font-sans text-sm tracking-wide transition-colors duration-150
                ${currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                  ? 'text-[#A38A66] border-b-2 border-[#A38A66]'
                  : 'text-[#4A4744] hover:text-[#A38A66]'
                }`}
            >
              {link.label}
            </a>
          ))}
        </nav>

        <!-- Desktop CTA -->
        <a
          href="tel:+48672620868"
          class="hidden lg:flex items-center gap-2 btn-primary text-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Zadzwoń
        </a>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          aria-label="Otwórz menu nawigacji"
          aria-expanded="false"
          class="lg:hidden p-2 text-[#2C2A28] hover:text-[#A38A66] transition-colors"
        >
          <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Mobile menu -->
      <div
        id="mobile-menu"
        class="hidden lg:hidden border-t border-stone-200 bg-[#FDFBF7]"
      >
        <nav class="container-wide py-4 flex flex-col gap-1">
          {navLinks.map(link => (
            <a
              href={link.href}
              class={`py-3 px-2 font-sans text-base border-b border-stone-100 transition-colors
                ${currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                  ? 'text-[#A38A66] font-medium'
                  : 'text-[#2C2A28] hover:text-[#A38A66]'
                }`}
            >
              {link.label}
            </a>
          ))}
          <div class="pt-4 flex flex-col gap-2">
            <a href="tel:+48672620868" class="btn-primary text-center text-sm">
              Zadzwoń: 67 26 20 868
            </a>
            <a href="mailto:sokolows@rejent.poznan.pl" class="btn-outline text-center text-sm">
              Napisz e-mail
            </a>
          </div>
        </nav>
      </div>
    </header>

    <!-- Page content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-[#231F1C] text-stone-300 mt-0">
      <div class="container-wide py-14">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

          <!-- Column 1: Firma -->
          <div class="lg:col-span-2">
            <h3 class="font-serif text-white text-xl font-medium mb-1">Kancelaria Notarialna</h3>
            <p class="text-[#A38A66] text-sm tracking-widest uppercase mb-4">Wągrowiec</p>
            <p class="text-stone-400 text-sm leading-relaxed mb-1">
              Katarzyna Sokołowska — notariusz
            </p>
            <p class="text-stone-400 text-sm leading-relaxed mb-5">
              Maria Majchrzak — notariusz
            </p>
            <p class="text-stone-500 text-xs leading-relaxed">
              Spółka Cywilna<br/>
              NIP: 766-199-76-89
            </p>
          </div>

          <!-- Column 2: Dane kontaktowe -->
          <div>
            <h4 class="font-sans text-white text-sm font-semibold tracking-widest uppercase mb-4">
              Kontakt
            </h4>
            <address class="not-italic">
              <p class="text-stone-400 text-sm mb-3">
                ul. Kościuszki 18B<br/>
                62-100 Wągrowiec
              </p>
              <a href="tel:+48672620868" class="block text-stone-300 hover:text-[#C4A87E] transition-colors text-sm mb-1">
                tel. 67 26 20 868
              </a>
              <a href="tel:+48672685665" class="block text-stone-300 hover:text-[#C4A87E] transition-colors text-sm mb-1">
                tel. 67 26 85 665
              </a>
              <a href="tel:+48693363868" class="block text-stone-300 hover:text-[#C4A87E] transition-colors text-sm mb-3">
                kom. 693 363 868
              </a>
              <a href="mailto:sokolows@rejent.poznan.pl" class="block text-stone-300 hover:text-[#C4A87E] transition-colors text-xs break-all mb-1">
                sokolows@rejent.poznan.pl
              </a>
              <a href="mailto:m.majchrzak@rejent.poznan.pl" class="block text-stone-300 hover:text-[#C4A87E] transition-colors text-xs break-all">
                m.majchrzak@rejent.poznan.pl
              </a>
            </address>
          </div>

          <!-- Column 3: Godziny + Nawigacja -->
          <div>
            <h4 class="font-sans text-white text-sm font-semibold tracking-widest uppercase mb-4">
              Godziny urzędowania
            </h4>
            <p class="text-stone-400 text-sm mb-1">Poniedziałek – Piątek</p>
            <p class="text-[#C4A87E] text-sm font-medium mb-6">8:00 – 16:00</p>

            <h4 class="font-sans text-white text-sm font-semibold tracking-widest uppercase mb-4">
              Nawigacja
            </h4>
            <nav class="flex flex-col gap-2">
              {navLinks.map(link => (
                <a href={link.href} class="text-stone-400 hover:text-[#C4A87E] transition-colors text-sm">
                  {link.label}
                </a>
              ))}
            </nav>
          </div>

        </div>

        <div class="border-t border-stone-700 mt-10 pt-6 flex flex-col md:flex-row items-center justify-between gap-4">
          <p class="text-stone-500 text-xs text-center md:text-left">
            © {new Date().getFullYear()} Kancelaria Notarialna Katarzyna Sokołowska i Maria Majchrzak. Wszelkie prawa zastrzeżone.
          </p>
          <p class="text-stone-600 text-xs">
            Nadzór: <a href="https://www.notariat.pl" target="_blank" rel="noopener noreferrer" class="hover:text-stone-400 transition-colors">Krajowa Rada Notarialna</a>
          </p>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('icon-open');
      const iconClose = document.getElementById('icon-close');

      btn?.addEventListener('click', () => {
        const isOpen = !menu?.classList.contains('hidden');
        if (isOpen) {
          menu?.classList.add('hidden');
          iconOpen?.classList.remove('hidden');
          iconClose?.classList.add('hidden');
          btn?.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        } else {
          menu?.classList.remove('hidden');
          iconOpen?.classList.add('hidden');
          iconClose?.classList.remove('hidden');
          btn?.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }
      });

      // Close mobile menu on link click
      menu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          menu?.classList.add('hidden');
          iconOpen?.classList.remove('hidden');
          iconClose?.classList.add('hidden');
          btn?.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        });
      });
    </script>
  </body>
</html>
